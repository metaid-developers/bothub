# Local real-data mode through the Vite dev proxy.
VITE_METASO_P2P_BASE_URL=/metaso-p2p

VITE_METAFILE_ACCELERATE_CONTENT_BASE=https://file.metaid.io/metafile-indexer/api/v1/files/accelerate/content
VITE_METAFILE_CONTENT_BASE=https://file.metaid.io/metafile-indexer/api/v1/files/content

# Production/staging option: point this at a metaso-p2p root deployment.
# Do not include /chat-api here. BotHub expects native metaso-p2p routes:
# /api/bot-hub/*, /api/private-chat/*, and /socket/socket.io.
# Current public metaso-p2p:
# VITE_METASO_P2P_BASE_URL=https://so.metaid.io

VITE_USE_AGGREGATOR_MOCK=false

VITE_USE_WS_MOCK=false
